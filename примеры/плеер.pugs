пусть html = "<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>pugmk плеер</title>\n  <style>\n    :root {\n      --card-bg: #f3f3f5;\n      --muted: #a9a9ae;\n      --text: #111;\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      background: #000;\n      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n    }\n    .card {\n      width: min(92vw, 760px);\n      border-radius: 72px;\n      background: var(--card-bg);\n      padding: 38px 38px 52px;\n      box-shadow: 0 20px 60px rgba(0,0,0,.45);\n    }\n    .cover {\n      width: 100%;\n      aspect-ratio: 1;\n      border-radius: 52px;\n      position: relative;\n      overflow: hidden;\n      background:\n        radial-gradient(110% 90% at 50% 52%, rgba(13,24,44,.95) 0%, rgba(89,108,137,.4) 24%, rgba(227,227,236,.72) 58%, rgba(237,237,241,.95) 100%),\n        conic-gradient(from 0deg at 50% 50%,\n          rgba(126,173,225,.33) 0deg,\n          rgba(255,174,202,.2) 34deg,\n          rgba(140,210,255,.26) 66deg,\n          rgba(255,255,255,.2) 100deg,\n          rgba(83,112,150,.45) 146deg,\n          rgba(179,200,238,.3) 190deg,\n          rgba(105,142,182,.4) 236deg,\n          rgba(255,255,255,.17) 280deg,\n          rgba(105,142,182,.34) 320deg,\n          rgba(126,173,225,.33) 360deg);\n      cursor: pointer;\n    }\n    .cover::before {\n      content: \"\";\n      position: absolute;\n      inset: -18%;\n      background:\n        repeating-conic-gradient(from 0deg,\n          rgba(255,255,255,.0) 0deg 12deg,\n          rgba(150,207,255,.45) 12deg 15deg,\n          rgba(254,195,219,.25) 15deg 18deg,\n          rgba(255,255,255,.0) 18deg 30deg);\n      filter: blur(1px);\n      mix-blend-mode: screen;\n    }\n    .cover::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(65% 24% at 50% 50%, rgba(13,19,36,.75) 0%, rgba(13,19,36,.0) 78%);\n    }\n    h1 {\n      margin: 38px 0 0;\n      text-align: center;\n      font-size: clamp(34px, 4.9vw, 62px);\n      font-weight: 500;\n      line-height: 1.12;\n      color: var(--text);\n    }\n    p {\n      margin: 8px 0 0;\n      text-align: center;\n      color: var(--muted);\n      font-size: clamp(26px, 4.2vw, 52px);\n      font-weight: 400;\n    }\n    .controls {\n      margin-top: 92px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: min(15vw, 140px);\n    }\n    button {\n      border: 0;\n      background: transparent;\n      cursor: pointer;\n      padding: 0;\n      color: #000;\n      position: relative;\n      width: min(18vw, 136px);\n      height: min(16vw, 120px);\n    }\n    .ico {\n      position: absolute;\n      inset: 0;\n      margin: auto;\n      width: 100%;\n      height: 100%;\n      background: linear-gradient(170deg, #9f9fa4 4%, #000 62%);\n      filter: drop-shadow(0 2px 1px rgba(0,0,0,.2));\n    }\n    .prev .ico {\n      clip-path: polygon(0 10%, 16% 10%, 16% 50%, 54% 10%, 54% 90%, 16% 50%, 92% 10%, 92% 90%, 54% 50%, 16% 90%, 16% 10%, 0 10%);\n    }\n    .play .ico {\n      clip-path: polygon(12% 10%, 92% 50%, 12% 90%);\n    }\n    .next .ico {\n      transform: scaleX(-1);\n      clip-path: polygon(0 10%, 16% 10%, 16% 50%, 54% 10%, 54% 90%, 16% 50%, 92% 10%, 92% 90%, 54% 50%, 16% 90%, 16% 10%, 0 10%);\n    }\n    input[type=\"file\"] { display: none; }\n    .hint {\n      margin-top: 26px;\n      text-align: center;\n      color: #8e8e92;\n      font-size: 14px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"cover\" id=\"cover\" title=\"Нажми, чтобы выбрать аудио\"></div>\n    <h1 id=\"title\">название трека (не файла)</h1>\n    <p id=\"artist\">артист</p>\n\n    <div class=\"controls\">\n      <button class=\"prev\" id=\"prev\" aria-label=\"Назад\"><span class=\"ico\"></span></button>\n      <button class=\"play\" id=\"play\" aria-label=\"Пауза/Пуск\"><span class=\"ico\"></span></button>\n      <button class=\"next\" id=\"next\" aria-label=\"Вперед\"><span class=\"ico\"></span></button>\n    </div>\n\n    <div class=\"hint\">Кликни по обложке и выбери аудио, название/артиста можно менять в коде.</div>\n    <input id=\"picker\" type=\"file\" accept=\"audio/*\" />\n    <audio id=\"audio\"></audio>\n  </div>\n\n  <script>\n    const title = document.getElementById('title');\n    const artist = document.getElementById('artist');\n    const playBtn = document.getElementById('play');\n    const prevBtn = document.getElementById('prev');\n    const nextBtn = document.getElementById('next');\n    const cover = document.getElementById('cover');\n    const picker = document.getElementById('picker');\n    const audio = document.getElementById('audio');\n\n    const playlist = [\n      { name: 'название трека (не файла)', artist: 'артист', src: null },\n      { name: 'второй трек', artist: 'артист 2', src: null }\n    ];\n\n    let index = 0;\n    let objectUrl = null;\n\n    function syncMeta() {\n      title.textContent = playlist[index].name;\n      artist.textContent = playlist[index].artist;\n      if (playlist[index].src) {\n        audio.src = playlist[index].src;\n      }\n    }\n\n    function stopIfNeeded() {\n      audio.pause();\n      playBtn.classList.add('play');\n    }\n\n    playBtn.addEventListener('click', async () => {\n      if (!audio.src) {\n        picker.click();\n        return;\n      }\n      if (audio.paused) {\n        await audio.play();\n      } else {\n        audio.pause();\n      }\n    });\n\n    prevBtn.addEventListener('click', () => {\n      index = (index - 1 + playlist.length) % playlist.length;\n      stopIfNeeded();\n      syncMeta();\n    });\n\n    nextBtn.addEventListener('click', () => {\n      index = (index + 1) % playlist.length;\n      stopIfNeeded();\n      syncMeta();\n    });\n\n    cover.addEventListener('click', () => picker.click());\n\n    picker.addEventListener('change', (e) => {\n      const file = e.target.files?.[0];\n      if (!file) return;\n      if (objectUrl) URL.revokeObjectURL(objectUrl);\n      objectUrl = URL.createObjectURL(file);\n      playlist[index].src = objectUrl;\n      stopIfNeeded();\n      syncMeta();\n      audio.play().catch(() => {});\n    });\n\n    audio.addEventListener('ended', () => {\n      index = (index + 1) % playlist.length;\n      syncMeta();\n      if (audio.src) audio.play().catch(() => {});\n    });\n\n    syncMeta();\n  </script>\n</body>\n</html>\n"
сохранить_файл("примеры/плеер.сгенерирован.html", html)
печать("Готово: примеры/плеер.сгенерирован.html")
